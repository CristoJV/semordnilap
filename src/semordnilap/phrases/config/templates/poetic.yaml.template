# Fragment-friendly phrase generation template.
# Useful for exploratory runs where incomplete poetic fragments are acceptable.

input: data/search/example_pairs.tsv
out: data/search/example.phrases.poetic.tsv

language:
  source: es
  target: pt

models:
  source_lm: data/lm/source.binary
  target_lm: data/lm/target.binary
  source_spacy_model: source_model_name
  target_spacy_model: target_model_name
  source_boundary_model: null
  target_boundary_model: null
  source_transition_model: null
  target_transition_model: null
  disable_syntax: false

search:
  min_source_count: 5
  min_target_count: 5
  min_pair_score: 0.0
  max_source_n: 3
  max_target_n: 3
  piece_limit: 1500
  min_pieces: 2
  max_pieces: 6
  beam_size: 1500
  candidate_pool_size: 6000
  max_results: 1000
  expand_sides: both
  center_seed_limit: 500
  allow_repeated_pieces: false
  keep_permutations: false

scoring:
  pair_weight: 1.0
  fluency_weight: 1.0
  syntax_weight: 0.8
  morphology_weight: 0.5
  partial_viability_weight: 1.0
  completion_weight: 0.4
  dead_end_weight: 0.5
  boundary_weight: 0.5
  edge_compatibility_weight: 1.0
  min_completion_score: 0.0
  min_partial_viability: -1000000000.0
  forbid_low_completion_final: false
  repeat_penalty: 6.0
  complete_bonus: 1.0
  morphology_agreement_features:
    - Gender
    - Number

output:
  trace_out: data/search/example.phrases.poetic.trace.json
  trace_top_n: 25

logging:
  level: info
  color: auto
